[Unit]
Description=BOSIO spherical window manager
After=local-fs.target network.target bootpy.service
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/home/xilinx/bosio_v2
Environment=XILINX_XRT=/usr
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -r /home/xilinx/bosio_v2/bitstream/bosio_output_disp.bit
ExecStartPre=/usr/bin/test -r /home/xilinx/bosio_v2/bitstream/bosio_output_disp.hwh
ExecStartPre=/usr/bin/test -r /home/xilinx/bosio_v2/libbosio_compositor.so
ExecStart=/usr/local/share/pynq-venv/bin/python3 -u /home/xilinx/bosio_v2/bosio_wm_daemon.py --bit /home/xilinx/bosio_v2/bitstream/bosio_output_disp.bit --m 16 --fps 12 --mouse auto --mouse-sensitivity 0.5 --socket-group xilinx
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

