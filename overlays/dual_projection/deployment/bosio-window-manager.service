[Unit]
Description=BOSIO spherical window manager
After=local-fs.target network.target bootpy.service
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/home/xilinx/bosio_boayo_m32_20261017
Environment=XILINX_XRT=/usr
Environment=PYTHONUNBUFFERED=1
Environment=BOSIO_COMPOSITOR_LIB=/home/xilinx/bosio_v2/libbosio_compositor.so
ExecStartPre=/usr/bin/test -r /home/xilinx/bosio_output_projection_dual_20261017/bosio_output_projection_dual.bit
ExecStartPre=/usr/bin/test -r /home/xilinx/bosio_output_projection_dual_20261017/bosio_output_projection_dual.hwh
ExecStartPre=/usr/bin/test -r /home/xilinx/bosio_v2/libbosio_compositor.so
ExecStart=/usr/local/share/pynq-venv/bin/python3 -u /home/xilinx/bosio_boayo_m32_20261017/bosio_wm_daemon.py --bit /home/xilinx/bosio_output_projection_dual_20261017/bosio_output_projection_dual.bit --m 32 --fps 30 --mouse auto --mouse-sensitivity 0.03 --socket-group xilinx
Restart=always
RestartSec=3
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
